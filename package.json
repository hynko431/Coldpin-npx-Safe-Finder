{
  "name": "coldpin",
  "version": "1.6.0",
  "mcpName": "io.github.hynko431/coldpin",
  "description": "Zero-execution npx discovery, static malware triage, tarball-to-source parity, clean-anchor recovery, and local stdio MCP server.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hynko431/Coldpin-npx-Safe-Finder.git"
  },
  "homepage": "https://coldpin-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/hynko431/Coldpin-npx-Safe-Finder/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "coldpin": "./lib/cli.mjs",
    "coldpin-mcp": "./lib/mcp.mjs",
    "coldpin-mcp-http": "./lib/mcp-http.mjs"
  },
  "files": [
    "lib/",
    "src/",
    "catalog/",
    "rules/",
    "agents/",
    "skills/",
    "assets/",
    "docs/",
    "examples/",
    "plugin.json",
    "mcp_config.json",
    "hooks.json",
    "server.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "TESTING.md",
    "MAINTENANCE.md",
    "CONTRIBUTING.md",
    "ACCESSIBILITY.md"
  ],
  "scripts": {
    "build": "node --no-warnings ./scripts/build_lib.ts",
    "build:docs": "node --no-warnings ./scripts/build_docs.ts",
    "build:docs:check": "node --no-warnings ./scripts/build_docs.ts --check",
    "start": "node --no-warnings ./lib/cli.mjs",
    "mcp": "node --no-warnings ./lib/mcp.mjs",
    "mcp:http": "node --no-warnings ./lib/mcp-http.mjs",
    "test": "node --no-warnings --test tests/security-quarantine.test.ts tests/static-triage-and-policy.test.ts tests/e2e-parity-and-bisect.test.ts tests/hardening-and-packaging.test.ts tests/mcp-server.test.ts tests/antigravity-plugin-components.test.ts tests/phase-e-http-and-app.test.ts tests/docs-site.test.ts tests/badge-function.test.ts tests/tier3-skill-eval.test.ts",
    "test:live": "node --no-warnings --test tests/live-network-e2e.test.ts",
    "eval:tier3": "node --no-warnings tests/tier3-skill-eval.ts",
    "lint:skill": "python scripts/lint_skill.py",
    "verify:hygiene": "python scripts/verify_hygiene.py",
    "check:stale": "python scripts/staleness_check.py 30",
    "eval:static": "python scripts/eval_static.py",
    "audit:self": "python scripts/self_audit_skillspector.py",
    "bench": "node --no-warnings ./scripts/run_benchmarks.ts",
    "bench:check": "node --no-warnings ./scripts/run_benchmarks.ts --check",
    "sign:skill": "node --no-warnings ./scripts/sign_and_verify_skill.ts --sign",
    "sign:verify": "node --no-warnings ./scripts/sign_and_verify_skill.ts --verify",
    "pack:plugin": "python scripts/pack_plugin.py --target all --verify --sync-workspace",
    "verify:all": "npm run build && npm run build:docs:check && npm test && npm run lint:skill && npm run verify:hygiene && npm run check:stale && npm run eval:static && npm run audit:self && npm run bench:check && npm run sign:verify && npm run pack:plugin"
  },
  "keywords": [
    "npx",
    "npm",
    "mcp",
    "model-context-protocol",
    "supply-chain-security",
    "malware-detection",
    "agent-skill",
    "sarif",
    "sbom"
  ]
}